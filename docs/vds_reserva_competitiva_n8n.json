      "id": "4cd7f39a-3eda-4f96-ab0c-0eee1c6cad27",
      "name": "TentarReserva",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1664,
        64
      ],
      "notesInFlow": true,
      "onError": "continueRegularOutput",
      "notes": "Dispara a tentativa e sabe se deu erro, se reservou ou se ficou na lista de espera"
    },
    {
      "parameters": {
        "jsCode": "// 1. Pega a mensagem de erro bruta que vem do nó anterior\nconst erroBruto = $input.item.json?.error?.message || \"\";\n\n// 2. Tenta encontrar o JSON interno escondido no texto (ex: 400 - \"{...}\")\nconst jsonMatch = erroBruto.match(/400 - \"(.*)\"/);\n\nlet mensagemInterna = \"\";\n\nif (jsonMatch && jsonMatch[1]) {\n  // Remove as barras de escape (\\\") para deixar o JSON limpo\n  const jsonLimpo = jsonMatch[1].replace(/\\\\\"/g, '\"');\n  try {\n    // Converte o texto limpo em um objeto JSON de verdade\n    const objInterno = JSON.parse(jsonLimpo);\n    // Extrai a mensagem amigável lá de dentro\n    mensagemInterna = objInterno.message;\n  } catch (e) {\n    mensagemInterna = \"\";\n  }\n}\n\n// 3. Se não conseguiu extrair a mensagem interna, usa o erro bruto modificado\nif (!mensagemInterna) {\n  mensagemInterna = erroBruto.replace(/\\\\\"/g, '\"');\n}\n\n// 4. Monta a mensagem final perfeitamente formatada\nconst mensagemFinal = `⚠️ *Falha na Tentativa de Reserva*\\n\\n*Detalhes*:\\n${mensagemInterna}`;\n\nreturn {\n  resultado: \"FALHA\",\n  mensagem: mensagemFinal\n};"
      },
