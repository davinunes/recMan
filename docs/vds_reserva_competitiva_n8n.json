    {
      "parameters": {
        "jsCode": "// Node para calcular dinamicamente a data alvo (ex: HOJE + 30 dias)\nconst item = $input.first().json;\nconst dias = parseInt(item.diasAntecedencia || 30, 10);\n\nconst targetDate = new Date();\ntargetDate.setDate(targetDate.getDate() + dias);\n\nconst day = String(targetDate.getDate()).padStart(2, '0');\nconst month = String(targetDate.getMonth() + 1).padStart(2, '0');\nconst year = targetDate.getFullYear();\n\nconst dtFormatted = `${day}/${month}/${year}`;\nlet dtIniStr = dtFormatted;\nlet dtFimStr = dtFormatted;\n\nif (item.tipoPeriodo === 'H' && item.horarioIni && item.horarioFim) {\n  dtIniStr = `${dtFormatted} ${item.horarioIni}`;\n  dtFimStr = `${dtFormatted} ${item.horarioFim}`;\n}\n\nreturn [{\n  json: {\n    ...item,\n    dataAlvoFormatada: dtFormatted,\n    dtIniPayload: dtIniStr,\n    dtFimPayload: dtFimStr\n  }\n}];"
      },
