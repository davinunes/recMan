  "item": [
    {
      "name": "1. Autenticação & Sessão",
      "item": [
        {
          "name": "1.1 Obter Token Anônimo (Boot)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Login bem-sucedido e token recebido\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "    pm.expect(jsonData.token).to.be.a(\"string\").and.not.empty;\r",
                  "});\r",
                  "\r",
                  "if (jsonData.token) {\r",
                  "    pm.collectionVariables.set(\"anonToken\", jsonData.token);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/anon",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "anon"
              ]
            },
            "description": "Obtém o token temporário anônimo necessário para realizar a chamada de login."
          },
          "response": []
        },
        {
          "name": "1.2 Login de Usuário (Obter Bearer Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Login bem-sucedido e token recebido\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(jsonData.refreshToken).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"bearerToken\", jsonData.token);",
                  "    pm.collectionVariables.set(\"refreshToken\", jsonData.refreshToken);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{anonToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app\": \"976\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{SUA_SENHA}}\",\n  \"crypt\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Autentica usuário e retorna o Bearer Token definitivo de sessão."
          },
          "response": []
        },
        {
          "name": "1.3 Checar Status da Sessão (Health Check)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuario/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuario",
                "status"
              ]
            },
            "description": "Valida se o Bearer Token continua ativo. Retorna HTTP 200 se ativo ou 401 se expirado."
          },
          "response": []
        },
        {
          "name": "1.4 Renovar Token (Refresh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Login bem-sucedido e token recebido\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "    pm.expect(jsonData.token).to.be.a(\"string\").and.not.empty;\r",
                  "    pm.expect(jsonData.refreshToken).to.be.a(\"string\").and.not.empty;\r",
                  "});\r",
                  "\r",
                  "if (jsonData.token) {\r",
                  "    pm.collectionVariables.set(\"bearerToken\", jsonData.token);\r",
                  "    pm.collectionVariables.set(\"refreshToken\", jsonData.refreshToken);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "accept",
                "value": "application/json, text/plain, */*",
                "disabled": false
              },
              {
                "key": "accept-language",
                "value": "pt-BR,pt;q=0.9,en-US;q=0.8,en;q=0.7",
                "disabled": false
              },
              {
                "key": "content-type",
                "value": "application/json",
                "disabled": false
              },
              {
                "key": "origin",
                "value": "https://app1.vidadesindico.com.br",
                "disabled": false
              },
              {
                "key": "priority",
                "value": "u=1, i",
                "disabled": false
              },
              {
                "key": "referer",
                "value": "https://app1.vidadesindico.com.br/",
                "disabled": false
              },
              {
                "key": "sec-ch-ua",
                "value": "\"Not;A=Brand\";v=\"8\", \"Chromium\";v=\"150\", \"Google Chrome\";v=\"150\"",
                "disabled": false
              },
              {
                "key": "sec-ch-ua-mobile",
                "value": "?0",
                "disabled": false
              },
              {
                "key": "sec-ch-ua-platform",
                "value": "\"Windows\"",
                "disabled": false
              },
              {
                "key": "sec-fetch-dest",
                "value": "empty",
                "disabled": false
              },
              {
                "key": "sec-fetch-mode",
                "value": "cors",
                "disabled": false
              },
              {
                "key": "sec-fetch-site",
                "value": "cross-site",
                "disabled": false
              },
              {
                "key": "user-agent",
                "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36",
                "disabled": false
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"token\":\"{{bearerToken}}\",\"refreshToken\":\"{{refreshToken}}\",\"crypt\":false}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://apiv8.vds.app.br/login/refresh",
              "protocol": "https",
              "host": [
                "apiv8",
