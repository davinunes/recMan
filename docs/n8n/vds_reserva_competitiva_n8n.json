    {
      "parameters": {
        "jsCode": "// Node para calcular dinamicamente a data alvo (ex: HOJE + 30 dias)\nconst item = $input.first().json;\nconst dias = parseInt(item.diasAntecedencia || 30, 10);\n\nconst targetDate = new Date();\ntargetDate.setDate(targetDate.getDate() + dias);\n\n// Formatação da data\nconst day = String(targetDate.getDate()).padStart(2, '0');\nconst month = String(targetDate.getMonth() + 1).padStart(2, '0');\nconst year = targetDate.getFullYear();\n\nconst dtFormatted = `${day}/${month}/${year}`;\nlet dtIniStr = dtFormatted;\nlet dtFimStr = dtFormatted;\n\nif (item.tipoPeriodo === 'H' && item.horarioIni && item.horarioFim) {\n  dtIniStr = `${dtFormatted} ${item.horarioIni}`;\n  dtFimStr = `${dtFormatted} ${item.horarioFim}`;\n}\n\n// Opcional: Array para traduzir o nome do dia para português\nconst diasSemanaExtenso = [\n  'Domingo', 'Segunda-feira', 'Terça-feira', 'Quarta-feira', \n  'Quinta-feira', 'Sexta-feira', 'Sábado'\n];\n\n// Captura o número (0-6) e o texto por extenso\nconst diaSemanaNumero = targetDate.getDay();\nconst diaSemanaTexto = diasSemanaExtenso[diaSemanaNumero];\n\nreturn [{\n  json: {\n    ...item,\n    dataAlvoFormatada: dtFormatted,\n    dtIniPayload: dtIniStr,\n    dtFimPayload: dtFimStr,\n    diaSemanaNumero: diaSemanaNumero, // Ex: 1\n    diaSemanaTexto: diaSemanaTexto   // Ex: 'Segunda-feira'\n  }\n}];\n"
      },
